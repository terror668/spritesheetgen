    "@types/node": "24.19.2",
    "@types/pngjs": "6.0.5",
    "esbuild": "0.27.0",
    "fflate": "0.8.3",
    "gifenc": "1.0.3",
    "pngjs": "5.0.0",
    "typescript": "6.0.3",
    "vitest": "^5.0.5",
    "zod": "4.6.7"
