{
  "name": "@spritesheetgen/cli",
  "version": "0.3.0",
  "mcpName": "io.github.terror668/spritesheetgen",
  "description": "Generate characters and animations, then export sprite sheets locally.",
  "homepage": "https://terror668.github.io/spritesheetgen/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/terror668/spritesheetgen.git"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "sprite-sheet",
    "spritesheet",
    "gamedev",
    "godot",
    "phaser",
    "pixel-art",
    "ai"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
